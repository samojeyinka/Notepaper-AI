{
    "preset": "laravel",
    "rules": {
        "blank_line_before_statement": {
            "statements": [
                "return", 
                "throw", 
                "try", 
                "if", 
                "foreach", 
                "for", 
                "while"
            ]
        },
        "class_attributes_separation": {
            "elements": {
                "method": "one",
                "property": "one",
                "trait_import": "one"
            }
        },
        "concat_space": {
            "spacing": "one"
        },
        "binary_operator_spaces": {
            "default": "single_space",
            "operators": {
                "=>": "align_single_space_minimal"
            }
        }
    }
}
