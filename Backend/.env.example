APP_NAME=NotepaperAI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---
# Local development defaults to SQLite. For production use PostgreSQL:
#   DB_CONNECTION=pgsql
#   DB_HOST=127.0.0.1
#   DB_PORT=5432
#   DB_DATABASE=notepaperai
#   DB_USERNAME=notepaperai_user
#   DB_PASSWORD=
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=notepaperai
# DB_USERNAME=notepaperai_user
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Log broadcasts locally. Set to "reverb" to use the websocket config below.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Queue retry window, in seconds. Must stay ABOVE the ai worker's --timeout
# (600s) so a long AI job is never re-dispatched while it is still running.
DB_QUEUE_RETRY_AFTER=660

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail ---
# Local default writes mail to the log. For production use Resend:
#   MAIL_MAILER=resend
#   RESEND_API_KEY=
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Auth (tymon/jwt-auth) ---
# Generate the secret with: php artisan jwt:secret
JWT_SECRET=
# JWT_TTL=1440
# JWT_REFRESH_TTL=20160

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Frontend URL used in notification links and post-auth redirects.
FRONTEND_URL=http://localhost:5173

# CORS: comma-separated list of browser origins allowed to call the API.
# FRONTEND_ORIGIN and FRONTEND_URL are used as single-value fallbacks.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Broadcasting (Laravel Reverb websockets) ---
# Set BROADCAST_CONNECTION=reverb (above) and fill these to enable real-time
# features. Generate the two secrets with:
#   php -r "echo bin2hex(random_bytes(16)), PHP_EOL;"
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

# Reverb values exposed to the frontend. Keep in sync with Frontend/.env.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Social OAuth (Laravel Socialite) ---
# Redirect URLs must point back at this API and include the /auth segment, e.g.
#   https://notepaperai-api.synchrome.co/api/v1/auth/google/callback
#   https://notepaperai-api.synchrome.co/api/v1/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=

# --- AI providers (sprint / study-plan / content generation) ---
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Transactional email provider (Resend) ---
RESEND_API_KEY=

# --- Payments (Paystack) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- Media search ---
PIXABAY_API_KEY=
