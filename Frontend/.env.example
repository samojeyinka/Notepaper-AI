# API base URL, including the /api/v1 prefix.
VITE_API_URL=http://localhost:8000/api/v1

# Router base path. Leave empty to serve the app from the domain root.
VITE_APP_BASENAME=

# Broadcasting (Laravel Reverb). These must match the backend REVERB_* values.
VITE_REVERB_SCHEME=http
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_APP_KEY=

# Cloudinary (unsigned upload preset used by the editor uploader).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
